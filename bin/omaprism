#!/usr/bin/env python3
"""
Omaprism — Prismatic per-workspace theming and visual cues for Omarchy & Hyprland.
Author: heelgueta <hermanelgueta@gmail.com>
"""

import os
import sys
import json
import socket
import argparse
import subprocess
import time
import base64
from pathlib import Path

try:
    import tomllib
except ImportError:
    import tomli as tomllib  # Fallback for Python <3.11 if needed

HOME = Path.home()
CONFIG_DIR = HOME / ".config" / "omarchy"
CONFIG_FILE = CONFIG_DIR / "omaprism.json"
STATE_DIR = HOME / ".local" / "state" / "omarchy" / "omaprism"
STATE_FILE = STATE_DIR / "current.json"
OMARCHY_PATH = Path(os.getenv("OMARCHY_PATH", "/usr/share/omarchy"))
USER_THEMES_PATH = HOME / ".config" / "omarchy" / "themes"
SYSTEM_THEMES_PATH = OMARCHY_PATH / "themes"
DEFAULT_CONFIG_PATH = Path(__file__).resolve().parent.parent / "config" / "default-config.json"


def ensure_config():
    """Ensure config file exists; if not, create it from defaults."""
    if not CONFIG_FILE.exists():
        CONFIG_DIR.mkdir(parents=True, exist_ok=True)
        if DEFAULT_CONFIG_PATH.exists():
            content = DEFAULT_CONFIG_PATH.read_text(encoding="utf-8")
        else:
            content = json.dumps({
                "version": 1,
                "enabled": True,
                "mode": "fast",
                "transition": "instant",
                "changeWallpaper": True,
                "changeBorders": True,
                "changeShell": True,
                "changeTerminals": True,
                "fullThemeDebounceMs": 500,
                "workspaces": {
                    "1": {"theme": "osaka-jade", "name": "Code", "accent": "#509475"},
                    "2": {"theme": "tokyo-night", "name": "Web", "accent": "#7aa2f7"},
                    "3": {"theme": "catppuccin", "name": "Chat", "accent": "#89b4fa"},
                    "4": {"theme": "gruvbox", "name": "DevOps", "accent": "#7daea3"},
                    "5": {"theme": "nord", "name": "Notes", "accent": "#81a1c1"},
                    "6": {"theme": "rose-pine", "name": "Media", "accent": "#56949f"},
                    "7": {"theme": "kanagawa", "name": "Design", "accent": "#dcd7ba"},
                    "8": {"theme": "everforest", "name": "Docs", "accent": "#7fbbb3"},
                    "9": {"theme": "hackerman", "name": "Terminal", "accent": "#82FB9C"},
                    "10": {"theme": "matte-black", "name": "Zen", "accent": "#e68e0d"}
                }
            }, indent=2)
        CONFIG_FILE.write_text(content, encoding="utf-8")
    
    try:
        return json.loads(CONFIG_FILE.read_text(encoding="utf-8"))
    except Exception as e:
        print(f"omaprism: error reading {CONFIG_FILE}: {e}", file=sys.stderr)
        return {}


def save_config(cfg):
    """Save config file safely."""
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    temp_file = CONFIG_DIR / "omaprism.json.tmp"
    temp_file.write_text(json.dumps(cfg, indent=2) + "\n", encoding="utf-8")
    temp_file.replace(CONFIG_FILE)


def get_hyprland_socket2():
    """Locate Hyprland socket2 for live events."""
    sig = os.getenv("HYPRLAND_INSTANCE_SIGNATURE")
    xdg_runtime = os.getenv("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")
    if not sig:
        hypr_dir = Path(xdg_runtime) / "hypr"
        if hypr_dir.exists():
            for p in hypr_dir.iterdir():
                if (p / ".socket2.sock").exists():
                    return str(p / ".socket2.sock")
        return None
    sock = Path(xdg_runtime) / "hypr" / sig / ".socket2.sock"
    return str(sock) if sock.exists() else None


def get_active_workspace():
    """Query current active workspace ID via hyprctl."""
    try:
        res = subprocess.run(
            ["hyprctl", "activeworkspace", "-j"],
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
            timeout=1
        )
        if res.returncode == 0:
            data = json.loads(res.stdout)
            return data.get("id", 1)
    except Exception:
        pass
    return 1


def find_theme_dir(theme_name):
    """Locate theme directory, checking user themes first then system themes."""
    slug = theme_name.lower().replace(" ", "-")
    user_theme = USER_THEMES_PATH / slug
    if user_theme.is_dir():
        return user_theme
    sys_theme = SYSTEM_THEMES_PATH / slug
    if sys_theme.is_dir():
        return sys_theme
    return None


def get_theme_assets(theme_name):
    """Extract colors.toml path, accent color, and wallpaper path."""
    theme_dir = find_theme_dir(theme_name)
    if not theme_dir:
        return None, "#ffffff", None
    
    colors_file = theme_dir / "colors.toml"
    accent = "#ffffff"
    colors_b64 = ""

    if colors_file.is_file():
        try:
            with open(colors_file, "rb") as f:
                data = tomllib.load(f)
            accent = data.get("accent", data.get("color4", "#ffffff"))
            colors_b64 = base64.b64encode(colors_file.read_bytes()).decode("ascii")
        except Exception as e:
            print(f"omaprism: failed parsing colors.toml: {e}", file=sys.stderr)
    
    # Locate wallpaper
    wallpaper = None
    user_bg_dir = HOME / ".config" / "omarchy" / "backgrounds" / theme_dir.name
    candidates = []
    if user_bg_dir.is_dir():
        candidates.extend(sorted(user_bg_dir.glob("*.[jJ][pP][gG]")))
        candidates.extend(sorted(user_bg_dir.glob("*.[pP][nN][gG]")))
        candidates.extend(sorted(user_bg_dir.glob("*.[wW][eE][bB][pP]")))
    
    sys_bg_dir = theme_dir / "backgrounds"
    if sys_bg_dir.is_dir():
        candidates.extend(sorted(sys_bg_dir.glob("*.[jJ][pP][gG]")))
        candidates.extend(sorted(sys_bg_dir.glob("*.[pP][nN][gG]")))
        candidates.extend(sorted(sys_bg_dir.glob("*.[wW][eE][bB][pP]")))
    
    if candidates:
        wallpaper = str(candidates[0])
    
    return colors_b64, accent, wallpaper


def apply_theme_osc_to_foot(theme_name):
    """Update running Foot terminal emulators with theme colors via OSC."""
    theme_dir = find_theme_dir(theme_name)
    if not theme_dir:
        return
    colors_file = theme_dir / "colors.toml"
    if not colors_file.is_file():
        return
    
    try:
        res = subprocess.run(
            ["omarchy-theme-osc", str(colors_file)],
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            timeout=1
        )
        if res.returncode == 0 and res.stdout:
            osc_seq = res.stdout
            pgrep = subprocess.run(["pgrep", "-x", "foot"], stdout=subprocess.PIPE, text=True)
            for fpid in pgrep.stdout.strip().split():
                if not fpid:
                    continue
                c_pgrep = subprocess.run(["pgrep", "-P", fpid], stdout=subprocess.PIPE, text=True)
                for cpid in c_pgrep.stdout.strip().split():
                    pts = HOME / f"/proc/{cpid}/fd/1"
                    try:
                        target = os.readlink(pts)
                        if target.startswith("/dev/pts/"):
                            with open(target, "wb", buffering=0) as tty:
                                tty.write(osc_seq)
                    except Exception:
                        pass
    except Exception:
        pass


def apply_workspace(ws_id, instant=None, force=False):
    """Apply theme for given workspace ID."""
    cfg = ensure_config()
    if not cfg.get("enabled", True) and not force:
        return True

    ws_str = str(ws_id)
    ws_cfg = cfg.get("workspaces", {}).get(ws_str)
    if not ws_cfg:
        return False

    theme = ws_cfg.get("theme", "")
    if not theme:
        return False

    # Check state to avoid redundant switches
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    current_state = {}
    if STATE_FILE.exists():
        try:
            current_state = json.loads(STATE_FILE.read_text(encoding="utf-8"))
        except Exception:
            pass

    if not force and current_state.get("workspace") == ws_id and current_state.get("theme") == theme:
        return True

    colors_b64, accent, wallpaper = get_theme_assets(theme)
    if "accent" in ws_cfg:
        accent = ws_cfg["accent"]
    if "wallpaper" in ws_cfg:
        wallpaper = ws_cfg["wallpaper"]

    transition = instant if instant is not None else (cfg.get("transition", "instant") == "instant")
    change_wp = cfg.get("changeWallpaper", True) and wallpaper
    change_shell = cfg.get("changeShell", True) and colors_b64
    change_borders = cfg.get("changeBorders", True) and accent
    change_terminals = cfg.get("changeTerminals", True)

    # 1. Update Wallpaper & Omarchy Bar/Shell Colors
    if change_wp and change_shell and not transition:
        subprocess.run(
            ["omarchy-shell", "background", "themeTransition", "", wallpaper, wallpaper, colors_b64, ""],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=2
        )
    else:
        if change_wp:
            method = "setInstant" if transition else "set"
            subprocess.run(
                ["omarchy-shell", "background", method, wallpaper],
                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=2
            )
        if change_shell:
            subprocess.run(
                ["omarchy-shell", "shell", "applyTheme", colors_b64, ""],
                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=2
            )

    # 2. Update Hyprland Window Borders
    if change_borders:
        lua_cmd = f"hl.config({{ general = {{ col = {{ active_border = '{accent}' }} }}, group = {{ col = {{ border_active = '{accent}' }} }} }})"
        subprocess.run(
            ["hyprctl", "eval", lua_cmd],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=1
        )

    # 3. Update Terminals
    if change_terminals:
        apply_theme_osc_to_foot(theme)

    # 4. Save state
    new_state = {
        "workspace": ws_id,
        "theme": theme,
        "name": ws_cfg.get("name", f"Workspace {ws_id}"),
        "accent": accent,
        "wallpaper": wallpaper,
        "updated_at": time.time()
    }
    STATE_FILE.write_text(json.dumps(new_state, indent=2) + "\n", encoding="utf-8")

    # 5. Full mode (system-wide theme switch)
    if cfg.get("mode") == "full":
        debounce_file = STATE_DIR / "last_full_switch"
        now = time.time()
        debounce_sec = cfg.get("fullThemeDebounceMs", 500) / 1000.0
        # Launch background process to avoid blocking
        cmd = f"sleep {debounce_sec}; if [[ $(cat '{STATE_FILE}' | jq -r .theme) == '{theme}' ]]; then omarchy theme set '{theme}' >/dev/null 2>&1; fi"
        subprocess.Popen(["bash", "-c", cmd], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    return True


def cmd_list(args):
    """List workspaces and assigned themes."""
    cfg = ensure_config()
    if args.json:
        print(json.dumps(cfg, indent=2))
        return

    workspaces = cfg.get("workspaces", {})
    active_ws = get_active_workspace()

    print(f"\033[1;36mOmaprism — Per-Workspace Themes\033[0m")
    print(f"Status: \033[32m{'Enabled' if cfg.get('enabled', True) else 'Disabled'}\033[0m | Mode: \033[33m{cfg.get('mode', 'fast')}\033[0m | Transition: \033[33m{cfg.get('transition', 'instant')}\033[0m\n")
    print(f"{'WS':<4} {'ACTIVE':<8} {'THEME':<18} {'ACCENT':<10} {'LABEL'}")
    print("-" * 55)

    for i in range(1, 11):
        ws_str = str(i)
        ws_info = workspaces.get(ws_str, {})
        theme = ws_info.get("theme", "(default)")
        accent = ws_info.get("accent", "-")
        label = ws_info.get("name", "")
        active_mark = "  \033[32m●\033[0m" if i == active_ws else "   "
        
        # Colorize accent hex if valid
        accent_disp = accent
        if accent.startswith("#") and len(accent) == 7:
            accent_disp = f"\033[38;2;{int(accent[1:3],16)};{int(accent[3:5],16)};{int(accent[5:7],16)}m■\033[0m {accent}"

        print(f"{i:<4} {active_mark:<8} {theme:<18} {accent_disp:<19} {label}")


def cmd_set(args):
    """Configure theme for a workspace."""
    cfg = ensure_config()
    ws_str = str(args.workspace)
    if int(ws_str) < 1 or int(ws_str) > 10:
        print("omaprism: workspace must be between 1 and 10", file=sys.stderr)
        sys.exit(1)

    theme_dir = find_theme_dir(args.theme)
    if not theme_dir:
        print(f"omaprism: theme '{args.theme}' not found in Omarchy themes.", file=sys.stderr)
        sys.exit(1)

    workspaces = cfg.setdefault("workspaces", {})
    ws_entry = workspaces.setdefault(ws_str, {})
    ws_entry["theme"] = theme_dir.name

    if args.name:
        ws_entry["name"] = args.name
    if args.accent:
        ws_entry["accent"] = args.accent
    elif "accent" not in ws_entry:
        _, accent, _ = get_theme_assets(theme_dir.name)
        ws_entry["accent"] = accent

    if args.wallpaper:
        ws_entry["wallpaper"] = args.wallpaper

    save_config(cfg)
    print(f"\033[32m✔\033[0m Assigned workspace {args.workspace} to theme '\033[1m{theme_dir.name}\033[0m'")

    if get_active_workspace() == args.workspace:
        apply_workspace(args.workspace, force=True)


def cmd_get(args):
    """Get info for workspace or current workspace."""
    cfg = ensure_config()
    ws = args.workspace if args.workspace else get_active_workspace()
    ws_str = str(ws)
    info = cfg.get("workspaces", {}).get(ws_str, {})
    if args.json:
        print(json.dumps(info, indent=2))
    else:
        print(f"Workspace {ws}: {info.get('theme', 'none')} ({info.get('name', 'unnamed')})")


def cmd_apply(args):
    """Apply theme for given workspace."""
    ws = args.workspace if args.workspace else get_active_workspace()
    instant = True if args.instant else None
    success = apply_workspace(ws, instant=instant, force=args.force)
    sys.exit(0 if success else 1)


def cmd_daemon(args):
    """Run socket listener daemon monitoring Hyprland workspace changes."""
    sock_path = get_hyprland_socket2()
    if not sock_path:
        print("omaprism daemon: could not find Hyprland socket2", file=sys.stderr)
        sys.exit(1)

    print(f"omaprism: starting daemon listening on {sock_path}")
    apply_workspace(get_active_workspace())

    while True:
        try:
            with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as client:
                client.connect(sock_path)
                buffer = ""
                while True:
                    data = client.recv(4096).decode("utf-8", errors="ignore")
                    if not data:
                        break
                    buffer += data
                    while "\n" in buffer:
                        line, buffer = buffer.split("\n", 1)
                        if line.startswith("workspace>>"):
                            ws_raw = line[len("workspace>>"):].strip()
                            try:
                                ws_id = int(ws_raw)
                                apply_workspace(ws_id)
                            except ValueError:
                                pass
        except Exception as e:
            time.sleep(1)


def cmd_menu(args):
    """Interactive TUI using gum to configure workspaces."""
    if not subprocess.run(["which", "gum"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0:
        print("omaprism menu requires 'gum'. Please run in an Omarchy terminal.", file=sys.stderr)
        sys.exit(1)

    cfg = ensure_config()
    themes_res = subprocess.run(["omarchy", "theme", "list"], stdout=subprocess.PIPE, text=True)
    all_themes = [t.strip() for t in themes_res.stdout.splitlines() if t.strip()]

    # Select workspace
    ws_choices = []
    for i in range(1, 11):
        cur_theme = cfg.get("workspaces", {}).get(str(i), {}).get("theme", "(none)")
        cur_name = cfg.get("workspaces", {}).get(str(i), {}).get("name", "")
        ws_choices.append(f"{i}: {cur_theme} [{cur_name}]")

    choose_ws = subprocess.run(
        ["gum", "choose", "--header=Select Workspace to Customize:", *ws_choices],
        stdout=subprocess.PIPE, text=True
    )
    selected_line = choose_ws.stdout.strip()
    if not selected_line:
        return
    ws_id = int(selected_line.split(":")[0])

    # Select theme
    choose_theme = subprocess.run(
        ["gum", "choose", "--header=Select Theme for Workspace " + str(ws_id) + ":", *all_themes],
        stdout=subprocess.PIPE, text=True
    )
    selected_theme = choose_theme.stdout.strip()
    if not selected_theme:
        return

    # Enter label
    curr_label = cfg.get("workspaces", {}).get(str(ws_id), {}).get("name", "")
    input_label = subprocess.run(
        ["gum", "input", f"--placeholder=Workspace label (e.g. Code)", f"--value={curr_label}"],
        stdout=subprocess.PIPE, text=True
    )
    new_label = input_label.stdout.strip()

    theme_slug = selected_theme.lower().replace(" ", "-")
    workspaces = cfg.setdefault("workspaces", {})
    ws_entry = workspaces.setdefault(str(ws_id), {})
    ws_entry["theme"] = theme_slug
    ws_entry["name"] = new_label
    _, accent, _ = get_theme_assets(theme_slug)
    ws_entry["accent"] = accent

    save_config(cfg)
    print(f"\033[32m✔\033[0m Workspace {ws_id} configured to \033[1m{selected_theme}\033[0m ({new_label})")
    
    if get_active_workspace() == ws_id:
        apply_workspace(ws_id, force=True)


def cmd_pick(args):
    """Open Omarchy's graphical theme switcher and assign chosen theme to active workspace."""
    ws = args.workspace if args.workspace else get_active_workspace()
    try:
        res = subprocess.run(["omarchy-theme-switcher"], stdout=subprocess.PIPE, text=True)
        theme = res.stdout.strip()
        if theme:
            args_set = argparse.Namespace(workspace=ws, theme=theme, name=None, accent=None, wallpaper=None)
            cmd_set(args_set)
    except Exception as e:
        print(f"omaprism pick error: {e}", file=sys.stderr)


def cmd_sync_hook(args):
    """Callback triggered by Omarchy theme-set hook to keep active workspace in sync."""
    theme = args.theme
    if not theme:
        return
    ws = get_active_workspace()
    cfg = ensure_config()
    workspaces = cfg.setdefault("workspaces", {})
    ws_entry = workspaces.setdefault(str(ws), {})
    theme_slug = theme.lower().replace(" ", "-")
    ws_entry["theme"] = theme_slug
    _, accent, _ = get_theme_assets(theme_slug)
    ws_entry["accent"] = accent
    save_config(cfg)

    STATE_DIR.mkdir(parents=True, exist_ok=True)
    new_state = {
        "workspace": ws,
        "theme": theme_slug,
        "name": ws_entry.get("name", f"Workspace {ws}"),
        "accent": accent,
        "updated_at": time.time()
    }
    STATE_FILE.write_text(json.dumps(new_state, indent=2) + "\n", encoding="utf-8")


def cmd_gui(args):
    """Summon Omarchy shell panel for Omaprism."""
    subprocess.run(["omarchy-shell", "shell", "summon", "heelgueta.omaprism", "{}"], timeout=2)


def main():
    parser = argparse.ArgumentParser(
        prog="omaprism",
        description="Omaprism — Prismatic per-workspace theming and visual cues for Omarchy & Hyprland."
    )
    sub = parser.add_subparsers(dest="command", help="Sub-commands")

    # apply
    p_apply = sub.add_parser("apply", help="Apply theme for workspace")
    p_apply.add_argument("workspace", type=int, nargs="?", help="Workspace ID (1-10)")
    p_apply.add_argument("--instant", action="store_true", help="Instant switch without animation")
    p_apply.add_argument("--force", action="store_true", help="Force re-apply even if already active")

    # pick
    p_pick = sub.add_parser("pick", help="Open visual theme selector and assign to active workspace")
    p_pick.add_argument("workspace", type=int, nargs="?", help="Workspace ID (defaults to active)")

    # sync-hook
    p_sync = sub.add_parser("sync-hook", help="Internal hook called on Omarchy theme-set")
    p_sync.add_argument("theme", type=str, help="Theme name")

    # set
    p_set = sub.add_parser("set", help="Assign a theme to a workspace")
    p_set.add_argument("workspace", type=int, help="Workspace ID (1-10)")
    p_set.add_argument("theme", type=str, help="Omarchy theme name or slug")
    p_set.add_argument("--name", type=str, help="Optional descriptive label (e.g. Code, Web)")
    p_set.add_argument("--accent", type=str, help="Custom accent hex color override")
    p_set.add_argument("--wallpaper", type=str, help="Custom wallpaper file path override")

    # get
    p_get = sub.add_parser("get", help="Get workspace info")
    p_get.add_argument("workspace", type=int, nargs="?", help="Workspace ID (defaults to active)")
    p_get.add_argument("--json", action="store_true", help="Output as JSON")

    # list
    p_list = sub.add_parser("list", help="List all workspace theme assignments")
    p_list.add_argument("--json", action="store_true", help="Output as JSON")

    # daemon
    sub.add_parser("daemon", help="Run standalone background listener daemon")

    # menu
    sub.add_parser("menu", help="Interactive TUI configuration menu using gum")

    # gui
    sub.add_parser("gui", help="Open Omaprism GUI settings panel")

    # init
    p_init = sub.add_parser("init", help="Initialize configuration file")
    p_init.add_argument("--force", action="store_true", help="Overwrite existing config")

    args = parser.parse_args()

    if not args.command:
        parser.print_help()
        sys.exit(0)

    if args.command == "apply":
        cmd_apply(args)
    elif args.command == "pick":
        cmd_pick(args)
    elif args.command == "sync-hook":
        cmd_sync_hook(args)
    elif args.command == "set":
        cmd_set(args)
    elif args.command == "get":
        cmd_get(args)
    elif args.command == "list":
        cmd_list(args)
    elif args.command == "daemon":
        cmd_daemon(args)
    elif args.command == "menu":
        cmd_menu(args)
    elif args.command == "gui":
        cmd_gui(args)
    elif args.command == "init":
        if args.force and CONFIG_FILE.exists():
            CONFIG_FILE.unlink()
        ensure_config()
        print(f"\033[32m✔\033[0m Initialized configuration at {CONFIG_FILE}")


if __name__ == "__main__":
    main()
